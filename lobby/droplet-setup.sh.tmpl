#!/bin/bash
# EMULSIFY LOBBY - droplet setup. Generated by emulsify-setup.ps1; runs as root over ssh. Idempotent.
# Touches only: user emulsify, /opt/emulsify, /var/lib/emulsify, /etc/emulsify, emulsify-lobby.service, and ONE
# appended block in /etc/caddy/Caddyfile (backed up first). ctforge-web, port 8765, /opt/ctforge, /var/lib/ctforge,
# /etc/ctforge and the two existing Caddy blocks are never touched.
set -u
KEY='__AGENTKEY__'
HOST='__HOST__'
echo "== droplet: $(hostname)   $(free -m | awk '/Mem:/{print $2" MB RAM, "$7" MB available"}')   disk $(df -h / | awk 'NR==2{print $4" free"}')"
if systemctl is-active --quiet ctforge-web; then echo "== ctforge-web: active (untouched)"; else echo "== ctforge-web: not active right now (nothing here touches it)"; fi
command -v python3 >/dev/null 2>&1 || { echo "== installing python3"; apt-get update -qq >/dev/null && apt-get install -y -qq python3 >/dev/null; }
command -v caddy >/dev/null 2>&1 || { echo "== caddy is not installed on this box; the doc said it is. Stopping."; exit 4; }
id -u emulsify >/dev/null 2>&1 || adduser --system --group --home /opt/emulsify --no-create-home emulsify >/dev/null 2>&1
mkdir -p /opt/emulsify /var/lib/emulsify /etc/emulsify
echo '__B64_LOBBY__' | base64 -d > /opt/emulsify/lobby.py
echo '__B64_PROFILES__' | base64 -d > /opt/emulsify/profiles.json
echo '__B64_MAKEPROFILES__' | base64 -d > /opt/emulsify/make-profiles.py
chown -R emulsify:emulsify /opt/emulsify /var/lib/emulsify
cat > /etc/emulsify/lobby.env <<EOF
EMULSIFY_HOST=127.0.0.1
EMULSIFY_PORT=8766
EMULSIFY_DATA=/var/lib/emulsify
EMULSIFY_KEEP_HOURS=24
EMULSIFY_PROFILES=/opt/emulsify/profiles.json
EMULSIFY_AGENT_KEY=$KEY
EMULSIFY_ORIGINS=__ORIGINS__
EOF
chmod 600 /etc/emulsify/lobby.env
echo '__B64_SERVICE__' | base64 -d > /etc/systemd/system/emulsify-lobby.service
systemctl daemon-reload
systemctl enable emulsify-lobby >/dev/null 2>&1
systemctl restart emulsify-lobby
sleep 1.5
H=$(curl -s -m 5 http://127.0.0.1:8766/health)
if [ -z "$H" ]; then echo "== lobby did not answer on 127.0.0.1:8766:"; journalctl -u emulsify-lobby -n 25 --no-pager; exit 2; fi
echo "== lobby on 127.0.0.1:8766: $H"
if grep -q "^$HOST {" /etc/caddy/Caddyfile; then
  echo "== caddy: the $HOST block is already there"
else
  BAK="/etc/caddy/Caddyfile.bak.$(date +%s)"; cp /etc/caddy/Caddyfile "$BAK"
  printf '\n' >> /etc/caddy/Caddyfile
  echo '__B64_CADDY__' | base64 -d >> /etc/caddy/Caddyfile
  if caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
    systemctl reload caddy && echo "== caddy: block added and reloaded (backup $BAK)"
  else
    cp "$BAK" /etc/caddy/Caddyfile; echo "== caddy: the new Caddyfile did NOT validate; restored the backup, nothing changed:"; caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile 2>&1 | tail -5; exit 3
  fi
fi
sleep 1
echo "== gibsoncttools.com still answers: $(curl -s -m 10 https://gibsoncttools.com/api/health | head -c 100)"
echo "== DONE"
