# Append to /etc/caddy/Caddyfile. The two existing gibsoncttools.com blocks stay exactly as they are.
emulsify.gibsoncttools.com {
    encode zstd gzip
    request_body {
        max_size 64MB
    }
    reverse_proxy 127.0.0.1:8766 {
        transport http {
            read_timeout 120s
        }
    }
}
