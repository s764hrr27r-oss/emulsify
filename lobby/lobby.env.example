# /etc/emulsify/lobby.env   (chmod 600, owned by root)
EMULSIFY_HOST=127.0.0.1
EMULSIFY_PORT=8766
EMULSIFY_DATA=/var/lib/emulsify
EMULSIFY_KEEP_HOURS=24
EMULSIFY_PROFILES=/opt/emulsify/profiles.json
# shared with agent.json on the lab PC. Make one:  python3 -c "import secrets;print(secrets.token_hex(24))"
EMULSIFY_AGENT_KEY=CHANGE-ME
EMULSIFY_ORIGINS=https://s764hrr27r-oss.github.io
